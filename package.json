{
  "name": "eve-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:format": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint src tests scripts --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "sync:wallet": "tsx src/cli/sync-wallet.ts",
    "check": "npm run check:format && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "json-bigint": "^1.0.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "eslint": "^10.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.8"
  }
}
