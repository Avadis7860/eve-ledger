# PostgreSQL connection string for the local EVE Ledger database.
DATABASE_URL=postgresql://eve_ledger:eve_ledger@localhost:5432/eve_ledger

# Corporation wallet scope: Master Wallet division 1 only.
ESI_CORPORATION_ID=
ESI_CLIENT_ID=
# Optional one-time migration seed. Normal authorization stores the token encrypted in PostgreSQL.
ESI_REFRESH_TOKEN=
# Register this exact URL in the EVE Developers Portal native application settings.
ESI_REDIRECT_URI=http://127.0.0.1:3000/auth/callback

# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ESI contract pin: update only after reviewing the official compatibility changes.
ESI_COMPATIBILITY_DATE=2026-11-09
ESI_USER_AGENT=EVE-Ledger/0.1 (https://github.com/Avadis7860/eve-ledger)
